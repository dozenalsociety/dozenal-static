      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>vinci</rdf:li>
               <rdf:li>vincico</rdf:li>
               <rdf:li>devlieger</rdf:li>
               <rdf:li>de vlieger</rdf:li>
               <rdf:li>number</rdf:li>
