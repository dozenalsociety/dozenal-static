         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Cyclic Graph emphasizing the multiplicative symmetry of divisors</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Vinci LLC Number Theory Visualization</rdf:li>
            </rdf:Alt>
