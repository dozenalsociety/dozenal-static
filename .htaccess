RewriteEngine On

# 1) Force canonical: https://dozenal.org/...
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.dozenal\.org$ [NC]
RewriteRule ^ https://dozenal.org%{REQUEST_URI} [R=301,L]

# 2) Legacy url redirects (old Drupal paths, etc.)

